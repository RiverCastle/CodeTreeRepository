<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.codetree.CodeTreeHRM.notice.mapper.NoticeMapper">

    <!-- ─────────────────────────────────────
         목록 조회 (검색/페이징)
    ───────────────────────────────────── -->
    <select id="searchNotices" resultType="com.codetree.CodeTreeHRM.notice.dto.NoticeDto">
        SELECT
            NTC_NO                                          AS ntcNo,
            NTC_TTL                                         AS ntcTtl,
            IMPRTNT_YN                                      AS imprtntYn,
            USE_YN                                          AS useYn,
            POPUP_YN                                        AS popupYn,
            POPUP_POS_CD                                    AS popupPosCd,
            INQRY_CNT                                       AS inqryCnt,
            DATE_FORMAT(REGIST_DT, '%Y-%m-%d %H:%i')       AS registDt,
            DATE_FORMAT(UPDT_DT,   '%Y-%m-%d %H:%i')       AS updtDt,
            RGSTR_NO                                        AS rgstrNo
        FROM ntc_notice
        <where>
            <if test="ntcTtl != null and ntcTtl != ''">
                AND NTC_TTL LIKE CONCAT('%', #{ntcTtl}, '%')
            </if>
            <if test="imprtntYn != null and imprtntYn != ''">
                AND IMPRTNT_YN = #{imprtntYn}
            </if>
            <if test="useYn != null and useYn != ''">
                AND USE_YN = #{useYn}
            </if>
            <if test="fromDt != null and fromDt != ''">
                AND DATE(REGIST_DT) >= #{fromDt}
            </if>
            <if test="toDt != null and toDt != ''">
                AND DATE(REGIST_DT) &lt;= #{toDt}
            </if>
        </where>
        ORDER BY IMPRTNT_YN DESC, NTC_NO DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- ─────────────────────────────────────
         총 건수
    ───────────────────────────────────── -->
    <select id="countNotices" resultType="int">
        SELECT COUNT(*)
        FROM ntc_notice
        <where>
            <if test="ntcTtl != null and ntcTtl != ''">
                AND NTC_TTL LIKE CONCAT('%', #{ntcTtl}, '%')
            </if>
            <if test="imprtntYn != null and imprtntYn != ''">
                AND IMPRTNT_YN = #{imprtntYn}
            </if>
            <if test="useYn != null and useYn != ''">
                AND USE_YN = #{useYn}
            </if>
            <if test="fromDt != null and fromDt != ''">
                AND DATE(REGIST_DT) >= #{fromDt}
            </if>
            <if test="toDt != null and toDt != ''">
                AND DATE(REGIST_DT) &lt;= #{toDt}
            </if>
        </where>
    </select>

    <!-- ─────────────────────────────────────
         단건 조회
    ───────────────────────────────────── -->
    <select id="findByNtcNo" resultType="com.codetree.CodeTreeHRM.notice.dto.NoticeDto">
        SELECT
            NTC_NO                                          AS ntcNo,
            NTC_TTL                                         AS ntcTtl,
            NTC_CN                                          AS ntcCn,
            IMPRTNT_YN                                      AS imprtntYn,
            USE_YN                                          AS useYn,
            POPUP_YN                                        AS popupYn,
            POPUP_POS_CD                                    AS popupPosCd,
            INQRY_CNT                                       AS inqryCnt,
            DATE_FORMAT(REGIST_DT, '%Y-%m-%d %H:%i')       AS registDt,
            DATE_FORMAT(UPDT_DT,   '%Y-%m-%d %H:%i')       AS updtDt,
            RGSTR_NO                                        AS rgstrNo
        FROM ntc_notice
        WHERE NTC_NO = #{ntcNo}
    </select>

    <!-- ─────────────────────────────────────
         등록
    ───────────────────────────────────── -->
    <insert id="insertNotice" useGeneratedKeys="true" keyProperty="ntcNo">
        INSERT INTO ntc_notice (NTC_TTL, NTC_CN, IMPRTNT_YN, USE_YN, POPUP_YN, POPUP_POS_CD, RGSTR_NO)
        VALUES (#{ntcTtl}, #{ntcCn}, #{imprtntYn}, #{useYn}, #{popupYn},
                <choose>
                    <when test="popupYn == 'Y'">#{popupPosCd}</when>
                    <otherwise>NULL</otherwise>
                </choose>,
                #{rgstrNo})
    </insert>

    <!-- ─────────────────────────────────────
         수정
    ───────────────────────────────────── -->
    <update id="updateNotice">
        UPDATE ntc_notice SET
            NTC_TTL      = #{ntcTtl},
            NTC_CN       = #{ntcCn},
            IMPRTNT_YN   = #{imprtntYn},
            USE_YN       = #{useYn},
            POPUP_YN     = #{popupYn},
            POPUP_POS_CD = <choose>
                               <when test="popupYn == 'Y'">#{popupPosCd}</when>
                               <otherwise>NULL</otherwise>
                           </choose>
        WHERE NTC_NO = #{ntcNo}
    </update>

    <!-- ─────────────────────────────────────
         삭제
    ───────────────────────────────────── -->
    <delete id="deleteNotice">
        DELETE FROM ntc_notice WHERE NTC_NO = #{ntcNo}
    </delete>

    <!-- ─────────────────────────────────────
         조회수 증가
    ───────────────────────────────────── -->
    <update id="incrementInqryCnt">
        UPDATE ntc_notice SET INQRY_CNT = INQRY_CNT + 1 WHERE NTC_NO = #{ntcNo}
    </update>

    <!-- ─────────────────────────────────────
         활성 팝업 공지 목록 (게시 + 팝업 ON)
    ───────────────────────────────────── -->
    <select id="findActivePopups" resultType="com.codetree.CodeTreeHRM.notice.dto.NoticeDto">
        SELECT
            NTC_NO                                          AS ntcNo,
            NTC_TTL                                         AS ntcTtl,
            NTC_CN                                          AS ntcCn,
            IMPRTNT_YN                                      AS imprtntYn,
            POPUP_POS_CD                                    AS popupPosCd,
            DATE_FORMAT(REGIST_DT, '%Y-%m-%d')              AS registDt
        FROM ntc_notice
        WHERE USE_YN = 'Y' AND POPUP_YN = 'Y'
        ORDER BY IMPRTNT_YN DESC, NTC_NO DESC
    </select>

</mapper>
